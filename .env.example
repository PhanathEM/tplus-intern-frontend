# URL of the TPLUS backend API (no trailing slash).
# The backend defaults to port 3000 — see backend/server.js.
#
# The deployed backend lives at:
#   https://tplus-intern-backend.onrender.com
# Point at that to run the frontend without a local backend. It is on Render's
# free tier, so the first request after ~15 minutes idle takes 30-60s while the
# instance wakes up.
VITE_API_BASE_URL=http://localhost:3000
